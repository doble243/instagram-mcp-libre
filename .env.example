# Start safely with sample responses; no Instagram calls are made in this mode.
MOCK_MODE=true

# Generate a long random value before exposing /mcp through a public tunnel.
MCP_BEARER_TOKEN=
# Para tiendas creadas dinámicamente por Conecta: clave privada del emisor.
# Genera ambas claves por separado con: openssl rand -hex 32
PROJECT_TOKEN_SIGNING_KEY=
# Opcional para proyectos fijos; JSON: {"worldcase":"token_aleatorio_de_32_caracteres_o_mas"}
# PROJECT_TOKENS_JSON=
PORT=8787
DATA_DIR=.data
# Producción: PostgreSQL privado y bucket Supabase privado.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_MEDIA_BUCKET=
MAX_UPLOAD_BYTES=52428800

# Para OAuth y medios con dominio HTTPS estable.
# Debe ser la misma URL pública que ve Meta para descargar tus medios.
PUBLIC_BASE_URL=
ASSET_SIGNING_SECRET=replace-with-another-long-random-secret

# Needed with MOCK_MODE=false. Store tokens privately, never commit .env.
# Published media URLs must be HTTPS and directly fetchable by Meta.
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_GRAPH_VERSION=v25.0
ALLOW_WRITES=false

# Conexión OAuth opcional de Meta/Instagram. Configura la misma URL en Meta:
# https://tu-dominio/oauth/instagram/callback
IG_CLIENT_ID=
IG_CLIENT_SECRET=
OAUTH_REDIRECT_URI=
# Genera 32 bytes hex con: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Opcional: varias cuentas conectadas manualmente. No uses en repositorio público.
# IG_ACCOUNTS_JSON=[{"id":"marca-a","username":"marca_a","ig_user_id":"...","access_token":"..."}]
