{
  "name": "instagram-mcp-libre",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "exports": {
    "./integration": {
      "types": "./dist/src/client.d.ts",
      "default": "./dist/src/client.js"
    },
    "./studio": {
      "types": "./dist/src/studio.d.ts",
      "default": "./dist/src/studio.js"
    },
    "./host": {
      "types": "./dist/src/host-handler.d.ts",
      "default": "./dist/src/host-handler.js"
    }
  },
  "bin": {
    "instagram-core": "./dist/src/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "tsc && node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.2.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@supabase/supabase-js": "^2.117.2",
    "dotenv": "^16.4.7",
    "pg": "^8.23.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
